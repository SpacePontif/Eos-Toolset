{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "dotnet",
            "task": "build",
            "group": "build",
            "problemMatcher": [],
            "label": "dotnet: build"
        },
        {
            "type": "process",
            "label": "dotnet: build (Release)",
            "command": "dotnet",
            "args": [
                "build",
                "EosToolset.sln",
                "-c",
                "Release",
                "/warn:0"
            ],
            "group": "build",
            "problemMatcher": []
        }
        ,
        {
            "label": "dotnet: publish eos-edit (self-contained single exe)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish",
                "eos-edit/eos-edit.csproj",
                "-c",
                "Release",
                "/warn:0",
                "-r",
                "win-x64",
                "--self-contained",
                "true",
                "/p:PublishSingleFile=true",
                "/p:PublishTrimmed=true"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        }
    ]
}


dotnet publish eos-edit/eos-edit.csproj -c Release